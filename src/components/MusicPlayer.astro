---
// Music Player Section
import fs from 'node:fs';
import path from 'node:path';

const songDir = path.join(process.cwd(), 'public', 'song');
let songFiles: string[] = [];
try {
  songFiles = fs.readdirSync(songDir)
    .filter((f: string) => f.endsWith('.mp3'))
    .sort();
} catch (e) {
  songFiles = [];
}

const songs = songFiles.map((file: string) => {
  const name = file.replace('.mp3', '').replace(/^\d+\s/, '');
  return { file: `/song/${file}`, name };
});
---

<section id="music" class="py-24 px-6 overflow-hidden">
  <div class="max-w-4xl mx-auto">
    <h2 class="section-heading" data-animate="fade-up">
      <span class="text-mint font-mono text-lg">06.</span>
      Music Player
    </h2>

    <p class="text-slate mb-8 max-w-2xl" data-animate="fade-up" data-delay="100">
      Enjoy some of my favorite Maher Zain tracks while you browse. 🎵
    </p>

    <!-- Player Card -->
    <div class="music-player-card" data-animate="fade-up" data-delay="200">
      <!-- Visualizer Background -->
      <div class="visualizer-bg" id="visualizer-bg">
        {Array.from({length: 20}).map((_, i) => (
          <div class="viz-bar" style={`--i: ${i}; left: ${i * 5}%`}></div>
        ))}
      </div>

      <!-- Now Playing -->
      <div class="now-playing">
        <div class="album-art" id="album-art">
          <div class="album-icon">🎵</div>
          <div class="album-pulse"></div>
        </div>
        <div class="song-info">
          <h3 class="song-title" id="song-title">Select a song</h3>
          <p class="song-artist" id="song-artist">Maher Zain</p>
        </div>
      </div>

      <!-- Progress Bar -->
      <div class="progress-container" id="progress-container">
        <span class="time-label" id="current-time">0:00</span>
        <div class="progress-bar">
          <div class="progress-fill" id="progress-fill"></div>
          <div class="progress-thumb" id="progress-thumb"></div>
        </div>
        <span class="time-label" id="duration-time">0:00</span>
      </div>

      <!-- Controls -->
      <div class="player-controls">
        <button class="control-btn small" id="shuffle-btn" title="Shuffle">
          <i class="fas fa-random"></i>
        </button>
        <button class="control-btn" id="prev-btn" title="Previous">
          <i class="fas fa-step-backward"></i>
        </button>
        <button class="control-btn play-btn" id="play-btn" title="Play">
          <i class="fas fa-play" id="play-icon"></i>
        </button>
        <button class="control-btn" id="next-btn" title="Next">
          <i class="fas fa-step-forward"></i>
        </button>
        <button class="control-btn small" id="repeat-btn" title="Repeat">
          <i class="fas fa-redo"></i>
        </button>
      </div>

      <!-- Volume -->
      <div class="volume-container">
        <button class="control-btn small" id="volume-btn" title="Volume">
          <i class="fas fa-volume-up" id="volume-icon"></i>
        </button>
        <div class="volume-bar" id="volume-bar">
          <div class="volume-fill" id="volume-fill" style="width: 80%"></div>
        </div>
      </div>
    </div>

    <!-- Playlist -->
    <div class="playlist-container" data-animate="fade-up" data-delay="300">
      <h4 class="playlist-title">
        <i class="fas fa-list"></i> Playlist
        <span class="song-count" id="song-count">{songs.length} songs</span>
      </h4>
      <div class="playlist-scroll" id="playlist">
        {songs.map((song, index) => (
          <button
            class="playlist-item"
            data-index={index}
            data-src={song.file}
            data-name={song.name}
          >
            <span class="playlist-num">{String(index + 1).padStart(2, '0')}</span>
            <span class="playlist-name">{song.name}</span>
            <span class="playlist-playing-icon"><i class="fas fa-volume-up"></i></span>
          </button>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .music-player-card {
    position: relative;
    background: linear-gradient(135deg, rgba(10, 25, 47, 0.9), rgba(17, 34, 64, 0.95));
    border: 1px solid rgba(100, 255, 218, 0.15);
    border-radius: 1rem;
    padding: 2rem;
    backdrop-filter: blur(12px);
    overflow: hidden;
    transition: all 0.4s ease;
  }
  .music-player-card:hover {
    border-color: rgba(100, 255, 218, 0.3);
    box-shadow: 0 8px 40px -12px rgba(100, 255, 218, 0.15);
  }

  /* Visualizer */
  .visualizer-bg {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 100%;
    pointer-events: none;
    opacity: 0.06;
    overflow: hidden;
  }
  .viz-bar {
    position: absolute;
    bottom: 0;
    width: 3%;
    background: linear-gradient(to top, var(--color-mint), transparent);
    border-radius: 4px 4px 0 0;
    height: 10%;
    transition: height 0.15s ease;
  }
  .visualizer-bg.playing .viz-bar {
    animation: vizPulse 0.8s ease-in-out infinite alternate;
    animation-delay: calc(var(--i) * 0.05s);
  }
  @keyframes vizPulse {
    0% { height: 10%; }
    100% { height: calc(20% + var(--i) * 3%); }
  }

  /* Now Playing */
  .now-playing {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 1.5rem;
    position: relative;
    z-index: 2;
  }
  .album-art {
    position: relative;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: linear-gradient(135deg, color-mix(in srgb, var(--color-mint) 20%, transparent), color-mix(in srgb, var(--color-mint) 5%, transparent));
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border: 2px solid color-mix(in srgb, var(--color-mint) 20%, transparent);
  }
  .album-art.spinning {
    animation: spin 4s linear infinite;
  }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
  .album-icon { font-size: 1.75rem; }
  .album-pulse {
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 2px solid color-mix(in srgb, var(--color-mint) 30%, transparent);
    opacity: 0;
  }
  .album-art.spinning .album-pulse {
    animation: pulse-ring 1.5s ease-out infinite;
  }
  @keyframes pulse-ring {
    0% { transform: scale(1); opacity: 0.6; }
    100% { transform: scale(1.3); opacity: 0; }
  }
  .song-info { overflow: hidden; }
  .song-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-light-slate);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 500px;
  }
  .song-artist {
    font-size: 0.8rem;
    color: var(--color-mint);
    margin-top: 0.15rem;
    font-family: monospace;
  }

  /* Progress */
  .progress-container {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
    position: relative;
    z-index: 2;
  }
  .time-label {
    font-size: 0.7rem;
    color: var(--color-slate);
    font-family: monospace;
    min-width: 36px;
    text-align: center;
  }
  .progress-bar {
    flex: 1;
    height: 4px;
    background: color-mix(in srgb, var(--color-slate) 20%, transparent);
    border-radius: 999px;
    cursor: pointer;
    position: relative;
    transition: height 0.15s;
  }
  .progress-bar:hover { height: 6px; }
  .progress-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--color-mint), var(--color-ocean));
    border-radius: 999px;
    width: 0%;
    transition: width 0.1s linear;
  }
  .progress-thumb {
    position: absolute;
    top: 50%;
    left: 0%;
    width: 12px;
    height: 12px;
    background: var(--color-mint);
    border-radius: 50%;
    transform: translate(-50%, -50%) scale(0);
    transition: transform 0.15s;
    box-shadow: 0 0 8px color-mix(in srgb, var(--color-mint) 50%, transparent);
  }
  .progress-bar:hover .progress-thumb { transform: translate(-50%, -50%) scale(1); }

  /* Controls */
  .player-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 1rem;
    position: relative;
    z-index: 2;
  }
  .control-btn {
    background: none;
    border: none;
    color: var(--color-slate);
    font-size: 1.1rem;
    cursor: pointer;
    transition: all 0.25s;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
  }
  .control-btn:hover { color: var(--color-mint); background: color-mix(in srgb, var(--color-mint) 8%, transparent); }
  .control-btn.small { font-size: 0.85rem; width: 36px; height: 36px; }
  .control-btn.active { color: var(--color-mint); }
  .play-btn {
    width: 56px;
    height: 56px;
    font-size: 1.25rem;
    border: 2px solid color-mix(in srgb, var(--color-mint) 40%, transparent) !important;
    color: var(--color-mint) !important;
    background: color-mix(in srgb, var(--color-mint) 8%, transparent) !important;
  }
  .play-btn:hover {
    background: color-mix(in srgb, var(--color-mint) 15%, transparent) !important;
    transform: scale(1.08);
    box-shadow: 0 0 20px color-mix(in srgb, var(--color-mint) 20%, transparent);
  }

  /* Volume */
  .volume-container {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    position: relative;
    z-index: 2;
  }
  .volume-bar {
    width: 100px;
    height: 4px;
    background: color-mix(in srgb, var(--color-slate) 20%, transparent);
    border-radius: 999px;
    cursor: pointer;
    overflow: hidden;
  }
  .volume-fill {
    height: 100%;
    background: var(--color-mint);
    border-radius: 999px;
    transition: width 0.1s;
  }

  /* Playlist */
  .playlist-container {
    margin-top: 1.5rem;
    background: color-mix(in srgb, var(--color-navy) 60%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-slate) 15%, transparent);
    border-radius: 0.75rem;
    overflow: hidden;
  }
  .playlist-title {
    padding: 1rem 1.25rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-light-slate);
    border-bottom: 1px solid color-mix(in srgb, var(--color-slate) 15%, transparent);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .playlist-title i { color: var(--color-mint); }
  .song-count {
    margin-left: auto;
    font-size: 0.75rem;
    color: var(--color-slate);
    font-family: monospace;
  }
  .playlist-scroll {
    max-height: 320px;
    overflow-y: auto;
  }
  .playlist-scroll::-webkit-scrollbar { width: 4px; }
  .playlist-scroll::-webkit-scrollbar-track { background: transparent; }
  .playlist-scroll::-webkit-scrollbar-thumb { background: color-mix(in srgb, var(--color-slate) 30%, transparent); border-radius: 999px; }

  .playlist-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    padding: 0.7rem 1.25rem;
    background: none;
    border: none;
    color: var(--color-slate);
    cursor: pointer;
    text-align: left;
    transition: all 0.2s;
    font-size: 0.85rem;
    font-family: inherit;
    border-bottom: 1px solid color-mix(in srgb, var(--color-slate) 5%, transparent);
  }
  .playlist-item:hover { background: color-mix(in srgb, var(--color-mint) 5%, transparent); color: var(--color-light-slate); }
  .playlist-item.active {
    background: color-mix(in srgb, var(--color-mint) 8%, transparent);
    color: var(--color-mint);
    border-left: 3px solid var(--color-mint);
  }
  .playlist-num {
    font-family: monospace;
    font-size: 0.75rem;
    min-width: 24px;
    opacity: 0.5;
  }
  .playlist-name {
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .playlist-playing-icon {
    color: var(--color-mint);
    font-size: 0.75rem;
    opacity: 0;
    transition: opacity 0.2s;
  }
  .playlist-item.active .playlist-playing-icon { opacity: 1; }

  @media (max-width: 640px) {
    .music-player-card { padding: 1.25rem; }
    .song-title { max-width: 200px; font-size: 1rem; }
    .volume-container { display: none; }
  }
</style>

<script is:inline define:vars={{ songs }}>
  window.__musicSongs = songs;
</script>

<script>
  const songs = (window as any).__musicSongs || [];
  const audio = new Audio();
  audio.volume = 0.8;

  let currentIndex = -1;
  let isPlaying = false;
  let isShuffle = false;
  let repeatMode = 0; // 0=off, 1=all, 2=one

  const $ = (id: string) => document.getElementById(id);
  const playBtn = $('play-btn');
  const playIcon = $('play-icon');
  const prevBtn = $('prev-btn');
  const nextBtn = $('next-btn');
  const shuffleBtn = $('shuffle-btn');
  const repeatBtn = $('repeat-btn');
  const progressContainer = $('progress-container');
  const progressFill = $('progress-fill');
  const progressThumb = $('progress-thumb');
  const currentTimeEl = $('current-time');
  const durationEl = $('duration-time');
  const songTitle = $('song-title');
  const albumArt = $('album-art');
  const vizBg = $('visualizer-bg');
  const volumeBar = $('volume-bar');
  const volumeFill = $('volume-fill');
  const volumeBtn = $('volume-btn');
  const volumeIcon = $('volume-icon');
  const playlist = $('playlist');

  function formatTime(s: number): string {
    if (isNaN(s)) return '0:00';
    const m = Math.floor(s / 60);
    const sec = Math.floor(s % 60);
    return `${m}:${sec < 10 ? '0' : ''}${sec}`;
  }

  function loadSong(index: number) {
    if (index < 0 || index >= songs.length) return;
    currentIndex = index;
    const song = songs[index];
    audio.src = song.file;
    if (songTitle) songTitle.textContent = song.name;

    // Update playlist active
    playlist?.querySelectorAll('.playlist-item').forEach((el, i) => {
      el.classList.toggle('active', i === index);
    });
  }

  function playSong() {
    if (currentIndex === -1 && songs.length > 0) loadSong(0);
    audio.play();
    isPlaying = true;
    if (playIcon) { playIcon.className = 'fas fa-pause'; }
    albumArt?.classList.add('spinning');
    vizBg?.classList.add('playing');
  }

  function pauseSong() {
    audio.pause();
    isPlaying = false;
    if (playIcon) { playIcon.className = 'fas fa-play'; }
    albumArt?.classList.remove('spinning');
    vizBg?.classList.remove('playing');
  }

  function nextSong() {
    let next = currentIndex + 1;
    if (isShuffle) next = Math.floor(Math.random() * songs.length);
    else if (next >= songs.length) next = 0;
    loadSong(next);
    playSong();
  }

  function prevSong() {
    if (audio.currentTime > 3) { audio.currentTime = 0; return; }
    let prev = currentIndex - 1;
    if (prev < 0) prev = songs.length - 1;
    loadSong(prev);
    playSong();
  }

  playBtn?.addEventListener('click', () => { isPlaying ? pauseSong() : playSong(); });
  nextBtn?.addEventListener('click', nextSong);
  prevBtn?.addEventListener('click', prevSong);

  shuffleBtn?.addEventListener('click', () => {
    isShuffle = !isShuffle;
    shuffleBtn.classList.toggle('active', isShuffle);
  });

  repeatBtn?.addEventListener('click', () => {
    repeatMode = (repeatMode + 1) % 3;
    repeatBtn.classList.toggle('active', repeatMode > 0);
    const icon = repeatBtn.querySelector('i');
    if (icon) icon.className = repeatMode === 2 ? 'fas fa-redo' : 'fas fa-redo';
    if (repeatMode === 2 && icon) icon.style.textDecoration = 'underline';
    else if (icon) icon.style.textDecoration = '';
  });

  audio.addEventListener('timeupdate', () => {
    const pct = (audio.currentTime / audio.duration) * 100 || 0;
    if (progressFill) progressFill.style.width = pct + '%';
    if (progressThumb) progressThumb.style.left = pct + '%';
    if (currentTimeEl) currentTimeEl.textContent = formatTime(audio.currentTime);
  });

  audio.addEventListener('loadedmetadata', () => {
    if (durationEl) durationEl.textContent = formatTime(audio.duration);
  });

  audio.addEventListener('ended', () => {
    if (repeatMode === 2) { audio.currentTime = 0; audio.play(); }
    else if (repeatMode === 1 || currentIndex < songs.length - 1) nextSong();
    else pauseSong();
  });

  // Click on progress bar
  const progBar = progressContainer?.querySelector('.progress-bar');
  progBar?.addEventListener('click', (e: Event) => {
    const me = e as MouseEvent;
    const rect = (progBar as HTMLElement).getBoundingClientRect();
    const pct = (me.clientX - rect.left) / rect.width;
    audio.currentTime = pct * audio.duration;
  });

  // Volume
  volumeBar?.addEventListener('click', (e: Event) => {
    const me = e as MouseEvent;
    const rect = (volumeBar as HTMLElement).getBoundingClientRect();
    const pct = Math.max(0, Math.min(1, (me.clientX - rect.left) / rect.width));
    audio.volume = pct;
    if (volumeFill) (volumeFill as HTMLElement).style.width = (pct * 100) + '%';
    updateVolumeIcon(pct);
  });

  volumeBtn?.addEventListener('click', () => {
    audio.muted = !audio.muted;
    updateVolumeIcon(audio.muted ? 0 : audio.volume);
  });

  function updateVolumeIcon(vol: number) {
    if (!volumeIcon) return;
    if (vol === 0 || audio.muted) volumeIcon.className = 'fas fa-volume-mute';
    else if (vol < 0.5) volumeIcon.className = 'fas fa-volume-down';
    else volumeIcon.className = 'fas fa-volume-up';
  }

  // Playlist click
  playlist?.addEventListener('click', (e: Event) => {
    const item = (e.target as HTMLElement).closest('.playlist-item') as HTMLElement | null;
    if (!item) return;
    const idx = parseInt(item.dataset.index || '0');
    loadSong(idx);
    playSong();
  });
</script>
