---
import { Image } from "astro:assets";
---

<section
  id="hero"
  class="min-h-screen flex items-center justify-center pt-20 px-6 overflow-hidden"
>
  <div class="max-w-4xl mx-auto">
    <div class="grid md:grid-cols-5 gap-12 items-center">
      <!-- Text Content -->
      <div class="md:col-span-3 space-y-6">
        <p
          class="text-mint font-mono text-sm md:text-base"
          data-animate="fade-right"
        >
          Hi, my name is
        </p>

        <h1
          class="text-4xl md:text-6xl lg:text-7xl font-serif font-bold text-light-slate"
          data-animate="fade-right"
          data-delay="100"
        >
          Muhammad Hisyam.
        </h1>

        <h2
          class="text-3xl md:text-5xl lg:text-6xl font-serif font-bold text-slate"
          data-animate="fade-right"
          data-delay="200"
        >
          I build things for the web.
        </h2>

        <p
          class="text-slate text-base md:text-lg max-w-xl leading-relaxed"
          data-animate="fade-up"
          data-delay="300"
        >
          I'm a software engineer specializing in building exceptional digital experiences. Currently focused on creating <span class="text-mint hover:underline cursor-default">accessible</span>, <span class="text-mint hover:underline cursor-default">human-centered</span> products that make a difference.
        </p>

        <div
          class="flex flex-wrap gap-4 pt-4"
          data-animate="fade-up"
          data-delay="400"
        >
          <a
            href="#projects"
            class="btn-primary group relative overflow-hidden"
          >
            <span class="relative z-10">Check out my work</span>
            <div
              class="absolute inset-0 bg-mint/20 translate-y-full group-hover:translate-y-0 transition-transform duration-300"
            >
            </div>
          </a>
          <a href="#contact" class="btn-primary group relative overflow-hidden">
            <span class="relative z-10">Get in touch</span>
            <div
              class="absolute inset-0 bg-mint/20 translate-y-full group-hover:translate-y-0 transition-transform duration-300"
            >
            </div>
          </a>
        </div>
      </div>

      <!-- Profile Image -->
      <div
        class="md:col-span-2 flex justify-center"
        data-animate="fade-left"
        data-delay="300"
      >
        <div class="relative group">
          <!-- Animated ring -->
          <div
            class="absolute -inset-4 border-2 border-mint/20 rounded-full animate-spin-slow opacity-0 group-hover:opacity-100 transition-opacity duration-500"
          >
          </div>

          <!-- Decorative border -->
          <div
            class="absolute -inset-2 bg-linear-to-br from-mint/20 to-transparent rounded-lg blur-sm group-hover:blur-none transition-all duration-300"
          >
          </div>
          <div
            class="absolute -inset-1 border-2 border-mint/30 rounded-lg translate-x-3 translate-y-3 group-hover:translate-x-2 group-hover:translate-y-2 transition-transform duration-300"
          >
          </div>

          <!-- Image container -->
          <div
            class="relative w-64 h-64 sm:w-72 sm:h-72 md:w-72 md:h-72 lg:w-80 lg:h-80 rounded-lg overflow-hidden border-2 border-mint/50 group-hover:border-mint transition-colors duration-300"
          >
            <Image
              src={"/image/hisyam.png"}
              alt="Muhammad Hisyam"
              class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500 group-hover:scale-110"
              width={320}
              height={320}
            />
            <div
              class="absolute inset-0 bg-mint/20 mix-blend-multiply group-hover:opacity-0 transition-opacity duration-300"
            >
            </div>
          </div>

          <!-- Floating particles -->
          <div
            class="absolute -top-2 -right-2 w-4 h-4 bg-mint/60 rounded-full animate-float group-hover:animate-ping"
          >
          </div>
          <div
            class="absolute -bottom-2 -left-2 w-3 h-3 bg-mint/40 rounded-full animate-float"
            style="animation-delay: 0.5s"
          >
          </div>
        </div>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div
      class="hidden md:flex justify-center mt-20"
      data-animate="fade-in"
      data-delay="600"
    >
      <a
        href="#about"
        class="text-slate hover:text-mint transition-colors duration-300 animate-bounce group"
      >
        <div class="flex flex-col items-center gap-2">
          <span
            class="text-xs font-mono opacity-0 group-hover:opacity-100 transition-opacity"
            >Scroll down</span
          >
          <svg
            class="w-6 h-6"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
          </svg>
        </div>
      </a>
    </div>
  </div>
</section>

<style>
  @keyframes spin-slow {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  .animate-spin-slow {
    animation: spin-slow 20s linear infinite;
  }
</style>
