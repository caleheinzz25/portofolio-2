---
import ApiPlaygroundComponent from "./ApiPlayground";
---

<section id="api-playground" class="py-24 px-6 overflow-hidden">
  <div class="max-w-4xl mx-auto">
    <h2 class="section-heading" data-animate="fade-up">
      <span class="text-mint font-mono text-lg">06.</span>
      API Response Playground
    </h2>

    <p class="text-slate mb-8 max-w-2xl" data-animate="fade-up" data-delay="100">
      Test real-time REST API requests directly from this playground. Select a pre-configured public REST API endpoint or enter a custom URL to inspect HTTP status, response latency, payload metrics, and syntax-highlighted response payloads.
    </p>

    <div data-animate="fade-up" data-delay="200">
      <ApiPlaygroundComponent client:visible />
    </div>
  </div>
</section>
