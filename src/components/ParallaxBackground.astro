---
// Parallax Background component with CSS scroll-driven animation & JS fallback
---

<div class="parallax-container fixed inset-0 pointer-events-none overflow-hidden z-0" aria-hidden="true">
  <!-- Ambient Parallax Orbs -->
  <div class="parallax-layer parallax-slow absolute -top-40 -left-40 w-96 h-96 rounded-full bg-mint/10 blur-3xl"></div>
  <div class="parallax-layer parallax-medium absolute top-1/3 -right-32 w-80 h-80 rounded-full bg-light-slate/10 blur-3xl"></div>
  <div class="parallax-layer parallax-fast absolute top-2/3 left-1/4 w-[500px] h-[500px] rounded-full bg-ocean/15 blur-3xl"></div>
  <div class="parallax-layer parallax-slow absolute -bottom-20 right-10 w-96 h-96 rounded-full bg-mint/10 blur-3xl"></div>

  <!-- Ambient Dot Grid Pattern -->
  <div class="parallax-layer parallax-grid absolute inset-0 opacity-[0.03] bg-[radial-gradient(var(--color-mint)_1px,transparent_1px)] [background-size:32px_32px]"></div>
</div>

<style>
  /* CSS Scroll-driven animations when supported */
  @supports ((animation-timeline: scroll()) or (animation-timeline: view())) {
    .parallax-slow {
      animation: parallaxSlow linear both;
      animation-timeline: scroll(root);
    }
    .parallax-medium {
      animation: parallaxMedium linear both;
      animation-timeline: scroll(root);
    }
    .parallax-fast {
      animation: parallaxFast linear both;
      animation-timeline: scroll(root);
    }
    .parallax-grid {
      animation: parallaxGrid linear both;
      animation-timeline: scroll(root);
    }

    @keyframes parallaxSlow {
      from { transform: translateY(0px); }
      to { transform: translateY(180px); }
    }
    @keyframes parallaxMedium {
      from { transform: translateY(0px); }
      to { transform: translateY(-300px); }
    }
    @keyframes parallaxFast {
      from { transform: translateY(0px); }
      to { transform: translateY(450px); }
    }
    @keyframes parallaxGrid {
      from { transform: translateY(0px); }
      to { transform: translateY(-100px); }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .parallax-layer {
      animation: none !important;
      transform: none !important;
    }
  }
</style>

<script>
  // Fallback for browsers without native CSS scroll-driven animations
  if (!CSS.supports('(animation-timeline: scroll()) and (animation-range: entry)')) {
    const layers = [
      { el: document.querySelector('.parallax-slow'), speed: 0.15 },
      { el: document.querySelector('.parallax-medium'), speed: -0.25 },
      { el: document.querySelector('.parallax-fast'), speed: 0.4 },
      { el: document.querySelector('.parallax-grid'), speed: -0.08 }
    ];

    let ticking = false;

    function updateParallax() {
      const scrollY = window.scrollY;
      layers.forEach(({ el, speed }) => {
        if (el) {
          (el as HTMLElement).style.transform = `translateY(${scrollY * speed}px)`;
        }
      });
      ticking = false;
    }

    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(updateParallax);
        ticking = true;
      }
    }, { passive: true });

    updateParallax();
  }
</script>
