---

<section id="skills" class="py-24 px-6 bg-navy/50 overflow-hidden">
  <div class="max-w-4xl mx-auto">
    <h2 class="section-heading" data-animate="fade-up">
      <span class="text-mint font-mono text-lg">02.</span>
      Skills & Technologies
    </h2>
    
    <div class="grid md:grid-cols-2 lg:grid-cols-2 gap-6">
      {skillCategories.map((category, index) => (
        <div 
          class="card group relative overflow-hidden"
          data-animate={index % 2 === 0 ? "fade-right" : "fade-left"}
          data-delay={String(index * 100)}
        >
          <!-- Animated background gradient -->
          <div class="absolute inset-0 bg-linear-to-br from-mint/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          
          <div class="relative z-10">
            <div class="mb-4">
              <h3 class="text-lg font-serif font-semibold text-light-slate group-hover:text-mint transition-colors duration-300">
                {category.category}
              </h3>
            </div>
            
            <div class="flex flex-wrap gap-2">
              {category.skills.map((skill, skillIndex) => (
                <span 
                  class="skill-tag px-3 py-1.5 text-sm bg-navy border border-slate/20 rounded-full text-slate 
                         hover:border-mint/50 hover:scale-105 hover:shadow-lg hover:shadow-mint/10
                         transition-all duration-300 cursor-default flex items-center gap-2"
                  style={`transition-delay: ${skillIndex * 30}ms`}
                >
                  <i class={skill.icon} style={`color: ${skill.color}`}></i>
                  {skill.name}
                </span>
              ))}
            </div>
          </div>
          
          <!-- Corner decorative element -->
          <div class="absolute top-0 right-0 w-16 h-16 bg-linear-to-bl from-mint/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 rounded-bl-full"></div>
        </div>
      ))}
    </div>
    
    <!-- Additional decorative element with animation -->
    <div class="mt-12 text-center" data-animate="fade-up" data-delay="600">
      <p class="text-slate text-sm">
        ...and always eager to learn new technologies! 
        <span class="text-mint animate-pulse">Currently exploring:</span> WebAssembly, AI/ML, Kubernetes
      </p>
    </div>
  </div>
</section>

<style>
  .card:hover .skill-tag {
    transform: translateY(-2px);
  }
  
  .skill-tag:hover i {
    transform: scale(1.2);
    transition: transform 0.3s ease;
  }
</style>
