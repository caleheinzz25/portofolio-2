---
// Terminal CLI Overlay Component (hisyam-cli)
---

<!-- Fixed Floating Toggle Button -->
<button
  id="terminal-toggle-btn"
  class="fixed bottom-6 right-6 z-[90] bg-navy/90 border border-mint/50 hover:border-mint text-mint hover:bg-mint/10 shadow-lg hover:shadow-mint/20 backdrop-blur-md px-3.5 py-2.5 rounded-lg flex items-center gap-2 font-mono text-sm tracking-wide cursor-pointer transition-all duration-300 transform hover:scale-105 active:scale-95 group select-none"
  aria-label="Toggle Terminal CLI Overlay"
  title="Toggle Terminal CLI (Ctrl+`)"
>
  <span class="text-mint font-bold text-base group-hover:animate-pulse">&gt;_</span>
  <span class="hidden sm:inline text-xs text-light-slate/90 font-medium">hisyam-cli</span>
  <kbd class="text-[10px] bg-slate/20 text-slate px-1.5 py-0.5 rounded border border-slate/30 font-mono">Ctrl+`</kbd>
</button>

<!-- Fullscreen Terminal Overlay Modal -->
<div
  id="terminal-overlay"
  class="fixed inset-0 z-[100] bg-navy/95 backdrop-blur-xl flex flex-col opacity-0 pointer-events-none transition-all duration-300 transform scale-98 font-mono text-light-slate select-text overflow-hidden"
  role="dialog"
  aria-modal="true"
  aria-label="hisyam-cli Terminal Overlay"
>
  <!-- CRT Scanline Effect Overlay -->
  <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(rgba(18,16,16,0)_50%,rgba(0,0,0,0.25)_50%)] bg-[length:100%_4px] opacity-30 z-10"></div>

  <!-- Terminal Header Bar -->
  <div class="flex items-center justify-between px-4 py-3 bg-light-navy/80 border-b border-slate/20 select-none z-20">
    <div class="flex items-center gap-2">
      <button
        id="terminal-close-dot"
        class="w-3 h-3 rounded-full bg-rose-500/80 hover:bg-rose-500 transition-colors focus:outline-none cursor-pointer"
        title="Close (Exit)"
        aria-label="Close terminal"
      ></button>
      <div class="w-3 h-3 rounded-full bg-amber-500/80" title="Minimize"></div>
      <div class="w-3 h-3 rounded-full bg-emerald-500/80" title="Maximize"></div>
      <span class="ml-2 text-xs text-slate/80 font-mono flex items-center gap-1.5">
        <i class="fas fa-terminal text-[10px] text-mint"></i>
        <span>hisyam@portfolio:~ (hisyam-cli v1.0.0)</span>
      </span>
    </div>

    <div class="flex items-center gap-3 text-xs text-slate/70 font-mono">
      <span class="hidden md:inline">
        Press <kbd class="px-1.5 py-0.5 bg-slate/20 rounded border border-slate/30 text-light-slate">Ctrl+`</kbd> or type <span class="text-mint font-semibold">'exit'</span>
      </span>
      <button
        id="terminal-close-btn"
        class="text-slate hover:text-mint p-1 focus:outline-none transition-colors cursor-pointer"
        aria-label="Close Terminal"
        title="Close Terminal"
      >
        <i class="fas fa-xmark text-lg"></i>
      </button>
    </div>
  </div>

  <!-- Terminal Body Output Container -->
  <div
    id="terminal-output"
    class="flex-1 p-4 md:p-6 overflow-y-auto font-mono text-xs sm:text-sm leading-relaxed space-y-4 z-20 scrollbar-thin scrollbar-thumb-slate/30 hover:scrollbar-thumb-mint/50"
  >
    <!-- Content injected dynamically -->
  </div>
</div>

<style>
  /* Extra styling for terminal elements */
  #terminal-overlay.is-open {
    opacity: 1;
    pointer-events: auto;
    transform: scale(1);
  }

  /* Custom terminal scrollbar */
  #terminal-output::-webkit-scrollbar {
    width: 6px;
  }
  #terminal-output::-webkit-scrollbar-track {
    background: rgba(13, 27, 42, 0.5);
  }
  #terminal-output::-webkit-scrollbar-thumb {
    background: rgba(149, 189, 215, 0.3);
    border-radius: 3px;
  }
  #terminal-output::-webkit-scrollbar-thumb:hover {
    background: var(--color-mint);
  }
</style>

<script>
  // Terminal CLI Client Controller
  document.addEventListener('DOMContentLoaded', () => {
    const toggleBtn = document.getElementById('terminal-toggle-btn');
    const overlay = document.getElementById('terminal-overlay');
    const closeBtn = document.getElementById('terminal-close-btn');
    const closeDot = document.getElementById('terminal-close-dot');
    const outputContainer = document.getElementById('terminal-output');

    if (!overlay || !outputContainer) return;

    let isOpen = false;
    let commandHistory: string[] = [];
    let historyIndex = -1;

    const BANNER_ASCII = `
 <span class="text-mint font-bold">_     _ _                       _ _ </span>
<span class="text-mint font-bold">| |__ (_) |  _   _  __ _ _ __ ___ | (_)</span>
<span class="text-mint font-bold">| '_ \\| | | | | | | / _\` | '_ \` _ \\| | |</span>
<span class="text-mint font-bold">| | | | | | | |_| | (_| | | | | | | | |</span>
<span class="text-mint font-bold">|_| |_|_|_|  \\__, |\\__,_|_| |_| |_|_|_|</span>
<span class="text-mint font-bold">             |___/                     </span>
`;

    const WELCOME_HEADER = `
<div class="border-b border-slate/20 pb-3 mb-4 space-y-1">
  <pre class="text-mint leading-tight font-mono text-[10px] sm:text-xs overflow-x-auto select-none">${BANNER_ASCII}</pre>
  <p class="text-light-slate font-semibold">Welcome to <span class="text-mint">hisyam-cli v1.0.0</span> - Interactive Portfolio Shell</p>
  <p class="text-slate text-xs">Type <span class="text-mint font-bold">'help'</span> to view available commands or navigate sections.</p>
</div>
`;

    const THEMES = ['gold', 'emerald', 'rose', 'violet', 'cyan'];

    function toggleOverlay() {
      isOpen = !isOpen;
      if (isOpen) {
        overlay?.classList.add('is-open');
        document.body.style.overflow = 'hidden';
        if (!outputContainer || outputContainer.children.length === 0) {
          initTerminalContent();
        } else {
          ensureInputForm();
          setTimeout(() => focusInput(), 50);
        }
      } else {
        overlay?.classList.remove('is-open');
        document.body.style.overflow = '';
      }
    }

    function ensureInputForm() {
      if (!outputContainer) return;
      let form = document.getElementById('terminal-form');
      if (!form) {
        const newFormContainer = document.createElement('div');
        newFormContainer.innerHTML = createInputLineHTML();
        outputContainer.appendChild(newFormContainer.firstElementChild as HTMLElement);
        setupFormListeners();
      }
    }

    function focusInput() {
      ensureInputForm();
      const input = document.getElementById('terminal-input') as HTMLInputElement | null;
      if (input) {
        input.focus();
      }
    }

    function initTerminalContent() {
      if (!outputContainer) return;
      outputContainer.innerHTML = WELCOME_HEADER;
      ensureInputForm();
      focusInput();
    }

    function createInputLineHTML(): string {
      return `
        <form id="terminal-form" class="flex items-center gap-2 mt-2">
          <label for="terminal-input" class="text-mint font-bold select-none flex-shrink-0">guest@hisyam-cli:~$</label>
          <input
            id="terminal-input"
            type="text"
            autocomplete="off"
            spellcheck="false"
            class="flex-1 bg-transparent border-none outline-none text-light-slate font-mono text-xs sm:text-sm focus:outline-none focus:ring-0 p-0 m-0"
            placeholder="type a command..."
          />
        </form>
      `;
    }

    function setupFormListeners() {
      const form = document.getElementById('terminal-form') as HTMLFormElement | null;
      const input = document.getElementById('terminal-input') as HTMLInputElement | null;

      if (!form || !input) return;

      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const cmd = input.value.trim();
        if (cmd) {
          executeCommand(cmd);
        }
      });

      input.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowUp') {
          e.preventDefault();
          if (commandHistory.length > 0) {
            if (historyIndex === -1) {
              historyIndex = commandHistory.length - 1;
            } else if (historyIndex > 0) {
              historyIndex--;
            }
            input.value = commandHistory[historyIndex] || '';
          }
        } else if (e.key === 'ArrowDown') {
          e.preventDefault();
          if (historyIndex !== -1) {
            if (historyIndex < commandHistory.length - 1) {
              historyIndex++;
              input.value = commandHistory[historyIndex] || '';
            } else {
              historyIndex = -1;
              input.value = '';
            }
          }
        }
      });
    }

    function appendCommandLog(cmd: string) {
      if (!outputContainer) return;

      const oldForm = document.getElementById('terminal-form');
      if (oldForm) {
        const logLine = document.createElement('div');
        logLine.className = 'flex items-center gap-2 my-1';
        logLine.innerHTML = `<span class="text-mint font-bold select-none">guest@hisyam-cli:~$</span> <span class="text-light-slate">${escapeHTML(cmd)}</span>`;
        oldForm.replaceWith(logLine);
      }
    }

    function escapeHTML(str: string): string {
      return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    function executeCommand(rawCmd: string) {
      const trimmed = rawCmd.trim();
      if (!trimmed) return;

      commandHistory.push(trimmed);
      historyIndex = -1;

      appendCommandLog(trimmed);

      const parts = trimmed.split(/\s+/);
      const command = parts[0].toLowerCase();
      const args = parts.slice(1);

      switch (command) {
        case 'help':
          renderResponse(`
<div class="text-slate space-y-1 my-2">
  <p class="text-mint font-bold mb-2">Available Commands:</p>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-1 font-mono text-xs">
    <div><span class="text-mint font-semibold">help</span>         - Display available commands</div>
    <div><span class="text-mint font-semibold">about</span>        - About Hisyam & jump to section</div>
    <div><span class="text-mint font-semibold">skills</span>       - View tech stack & jump to section</div>
    <div><span class="text-mint font-semibold">projects</span>     - Explore projects & jump to section</div>
    <div><span class="text-mint font-semibold">contact</span>      - Contact details & jump to section</div>
    <div><span class="text-mint font-semibold">music</span>        - Music player & jump to section</div>
    <div><span class="text-mint font-semibold">games</span>        - Play mini-games & jump to section</div>
    <div><span class="text-mint font-semibold">theme [name]</span> - Change color theme (gold, emerald, rose, violet, cyan)</div>
    <div><span class="text-mint font-semibold">clear</span>        - Clear terminal output screen</div>
    <div><span class="text-mint font-semibold">exit</span>         - Close terminal overlay</div>
  </div>
</div>
          `);
          break;

        case 'about':
          renderResponse(`
<div class="text-slate space-y-1 my-2">
  <p class="text-mint font-bold">[ABOUT MUHAMMAD HISYAM]</p>
  <p class="text-light-slate">Software Engineer based in Indonesia.</p>
  <p>Specializing in building high-performance web applications, scalable backends, and intuitive user experiences with modern web technologies.</p>
  <p class="text-mint text-xs mt-1">➜ Smooth scrolling to <span class="underline">#about</span> section...</p>
</div>
          `, '#about');
          break;

        case 'skills':
          renderResponse(`
<div class="text-slate space-y-1 my-2">
  <p class="text-mint font-bold">[TECHNICAL SKILLS]</p>
  <p><span class="text-light-slate font-semibold">• Languages:</span> HTML5, CSS3, JavaScript, TypeScript, Python, PHP, SQL</p>
  <p><span class="text-light-slate font-semibold">• Frontend:</span> React, Astro, Next.js, Tailwind CSS, Vue</p>
  <p><span class="text-light-slate font-semibold">• Backend & Tools:</span> Node.js, Express, REST APIs, Git, Docker, PostgreSQL</p>
  <p class="text-mint text-xs mt-1">➜ Smooth scrolling to <span class="underline">#skills</span> section...</p>
</div>
          `, '#skills');
          break;

        case 'projects':
          renderResponse(`
<div class="text-slate space-y-1 my-2">
  <p class="text-mint font-bold">[FEATURED PROJECTS]</p>
  <p><span class="text-light-slate font-semibold">1. Portfolio V2:</span> Modern retro personal portfolio built with Astro & Tailwind CSS.</p>
  <p><span class="text-light-slate font-semibold">2. Fullstack Apps:</span> High-performance web tools & real-time applications.</p>
  <p><span class="text-light-slate font-semibold">3. Mini Games Suite:</span> Arcade retro games built with React components.</p>
  <p class="text-mint text-xs mt-1">➜ Smooth scrolling to <span class="underline">#projects</span> section...</p>
</div>
          `, '#projects');
          break;

        case 'contact':
          renderResponse(`
<div class="text-slate space-y-1 my-2">
  <p class="text-mint font-bold">[CONTACT INFORMATION]</p>
  <p><span class="text-light-slate font-semibold">• Email:</span> Reach out via the contact form on page</p>
  <p><span class="text-light-slate font-semibold">• GitHub:</span> github.com/caleheinzz25</p>
  <p><span class="text-light-slate font-semibold">• Status:</span> Open for opportunities & collaborations</p>
  <p class="text-mint text-xs mt-1">➜ Smooth scrolling to <span class="underline">#contact</span> section...</p>
</div>
          `, '#contact');
          break;

        case 'music':
          renderResponse(`
<div class="text-slate space-y-1 my-2">
  <p class="text-mint font-bold">[MUSIC PLAYER]</p>
  <p class="text-light-slate">Listen to curated tracks while exploring the site.</p>
  <p class="text-mint text-xs mt-1">➜ Smooth scrolling to <span class="underline">#music</span> section...</p>
</div>
          `, '#music');
          break;

        case 'games':
          renderResponse(`
<div class="text-slate space-y-1 my-2">
  <p class="text-mint font-bold">[MINI GAMES]</p>
  <p><span class="text-light-slate font-semibold">1. Snake Game:</span> Classic retro arcade game.</p>
  <p><span class="text-light-slate font-semibold">2. Memory Match:</span> Test your memory with card pairs.</p>
  <p><span class="text-light-slate font-semibold">3. Typing Speed Test:</span> Measure your WPM typing speed.</p>
  <p class="text-mint text-xs mt-1">➜ Smooth scrolling to <span class="underline">#mini-games</span> section...</p>
</div>
          `, '#mini-games');
          break;

        case 'theme':
          handleThemeCommand(args);
          break;

        case 'clear':
          if (outputContainer) {
            outputContainer.innerHTML = WELCOME_HEADER;
            ensureInputForm();
            focusInput();
          }
          break;

        case 'exit':
          toggleOverlay();
          ensureInputForm();
          break;

        default:
          renderResponse(`
<div class="text-rose-400 my-1">
  Command not found: <span class="font-bold">'${escapeHTML(trimmed)}'</span>. Type <span class="text-mint font-bold">'help'</span> for available commands.
</div>
          `);
          break;
      }
    }

    function handleThemeCommand(args: string[]) {
      const currentTheme = document.documentElement.getAttribute('data-theme') || 'gold';

      if (args.length === 0) {
        const currentIndex = THEMES.indexOf(currentTheme);
        const nextIndex = (currentIndex + 1) % THEMES.length;
        const nextTheme = THEMES[nextIndex];
        setTheme(nextTheme);
        renderResponse(`
<div class="text-slate my-1">
  Theme cycled to <span class="text-mint font-bold">'${nextTheme}'</span>. Available themes: ${THEMES.join(', ')}.
</div>
        `);
      } else {
        const targetTheme = args[0].toLowerCase();
        if (THEMES.includes(targetTheme)) {
          setTheme(targetTheme);
          renderResponse(`
<div class="text-slate my-1">
  Theme set to <span class="text-mint font-bold">'${targetTheme}'</span>. Accent color updated!
</div>
          `);
        } else {
          renderResponse(`
<div class="text-rose-400 my-1">
  Invalid theme: <span class="font-bold">'${escapeHTML(targetTheme)}'</span>. Valid options: ${THEMES.join(', ')}.
</div>
          `);
        }
      }
    }

    function setTheme(themeName: string) {
      document.documentElement.setAttribute('data-theme', themeName);
      try {
        localStorage.setItem('portfolio-accent', themeName);
      } catch (e) {
        // ignore
      }
    }

    function renderResponse(htmlContent: string, scrollTargetId?: string) {
      if (!outputContainer) return;

      const responseElement = document.createElement('div');
      responseElement.className = 'response-block my-2';
      responseElement.innerHTML = htmlContent;

      // Animate line reveal for typing effect
      const lines = Array.from(responseElement.querySelectorAll('p, div, pre')) as HTMLElement[];
      if (lines.length > 0) {
        lines.forEach((line) => {
          line.style.opacity = '0';
          line.style.transform = 'translateY(4px)';
          line.style.transition = 'opacity 0.15s ease, transform 0.15s ease';
        });

        outputContainer.appendChild(responseElement);

        lines.forEach((line, index) => {
          setTimeout(() => {
            line.style.opacity = '1';
            line.style.transform = 'translateY(0)';
            if (outputContainer) outputContainer.scrollTop = outputContainer.scrollHeight;
          }, index * 25);
        });
      } else {
        outputContainer.appendChild(responseElement);
      }

      // Append new input form
      const newFormContainer = document.createElement('div');
      newFormContainer.innerHTML = createInputLineHTML();
      outputContainer.appendChild(newFormContainer.firstElementChild as HTMLElement);

      setupFormListeners();

      // Auto scroll terminal to bottom
      outputContainer.scrollTop = outputContainer.scrollHeight;

      focusInput();

      // Section navigation smooth scroll if specified
      if (scrollTargetId) {
        const targetEl = document.querySelector(scrollTargetId);
        if (targetEl) {
          targetEl.scrollIntoView({ behavior: 'smooth' });
        }
      }
    }

    toggleBtn?.addEventListener('click', toggleOverlay);
    closeBtn?.addEventListener('click', toggleOverlay);
    closeDot?.addEventListener('click', toggleOverlay);

    overlay.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.id === 'terminal-close-btn' || target.id === 'terminal-close-dot' || target.closest('#terminal-close-btn') || target.closest('#terminal-close-dot')) {
        return;
      }
      const selection = window.getSelection();
      if (!selection || selection.toString().length === 0) {
        focusInput();
      }
    });

    window.addEventListener('keydown', (e: KeyboardEvent) => {
      if ((e.ctrlKey || e.metaKey) && (e.key === '`' || e.code === 'Backquote')) {
        e.preventDefault();
        toggleOverlay();
      } else if (e.key === 'Escape' && isOpen) {
        e.preventDefault();
        toggleOverlay();
      }
    });

    try {
      const savedTheme = localStorage.getItem('portfolio-accent');
      if (savedTheme && THEMES.includes(savedTheme)) {
        document.documentElement.setAttribute('data-theme', savedTheme);
      }
    } catch (e) {
      // ignore
    }
  });
</script>
