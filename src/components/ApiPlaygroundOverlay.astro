---
import ApiPlaygroundComponent from "./ApiPlayground";
---

<!-- Fixed Floating Toggle Button for API Demo -->
<button
  id="api-demo-toggle-btn"
  class="fixed bottom-6 right-36 z-[90] bg-navy/90 border border-mint/50 hover:border-mint text-mint hover:bg-mint/10 shadow-lg hover:shadow-mint/20 backdrop-blur-md px-3.5 py-2.5 rounded-lg flex items-center gap-2 font-mono text-sm tracking-wide cursor-pointer transition-all duration-300 transform hover:scale-105 active:scale-95 group select-none"
  aria-label="Toggle Interactive API Demo Modal"
  title="Open API Demo Playground"
>
  <span class="text-mint font-bold text-base group-hover:animate-bounce">⚡</span>
  <span class="hidden sm:inline text-xs text-light-slate/90 font-medium">API Demo</span>
  <kbd class="text-[10px] bg-slate/20 text-slate px-1.5 py-0.5 rounded border border-slate/30 font-mono">Alt+A</kbd>
</button>

<!-- Fullscreen Pop-up Modal Overlay -->
<div
  id="api-demo-overlay"
  class="fixed inset-0 z-[100] bg-navy/95 backdrop-blur-xl flex flex-col items-center justify-center p-4 md:p-8 opacity-0 pointer-events-none transition-all duration-300 transform scale-95 font-mono text-light-slate select-text overflow-hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Interactive API Demo Modal"
>
  <!-- Background Ambient Glow -->
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(249,232,162,0.08)_0%,transparent_70%)] z-0"></div>

  <!-- Modal Card Window -->
  <div class="relative w-full max-w-5xl max-h-[90vh] bg-navy/90 border border-mint/30 rounded-2xl shadow-2xl flex flex-col overflow-hidden z-10 backdrop-blur-2xl">
    
    <!-- Modal Window Header Bar -->
    <div class="flex items-center justify-between px-6 py-4 bg-light-navy/80 border-b border-slate/20 select-none">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-lg bg-mint/10 border border-mint/30 flex items-center justify-center text-mint font-bold text-base">
          ⚡
        </div>
        <div>
          <h3 class="text-base sm:text-lg font-serif font-bold text-light-slate flex items-center gap-2">
            Interactive API Playground
          </h3>
          <p class="text-xs text-slate font-mono hidden sm:block">
            Test REST APIs, latency metrics & pretty-printed JSON payloads
          </p>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <kbd class="hidden sm:inline text-xs text-slate bg-slate/20 px-2 py-1 rounded border border-slate/30 font-mono">Esc to close</kbd>
        <button
          id="api-demo-close-btn"
          class="w-9 h-9 rounded-lg bg-slate/10 hover:bg-rose-500/20 text-slate hover:text-rose-400 border border-slate/20 hover:border-rose-500/40 flex items-center justify-center transition-all duration-200 cursor-pointer"
          aria-label="Close API Demo Modal"
          title="Close Modal"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Modal Body Content -->
    <div class="flex-1 overflow-y-auto p-4 sm:p-6 scrollbar-thin scrollbar-thumb-slate/30">
      <ApiPlaygroundComponent client:idle />
    </div>

  </div>
</div>

<style>
  #api-demo-overlay.is-open {
    opacity: 1;
    pointer-events: auto;
    transform: scale(1);
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const toggleBtn = document.getElementById("api-demo-toggle-btn");
    const overlay = document.getElementById("api-demo-overlay");
    const closeBtn = document.getElementById("api-demo-close-btn");

    if (!overlay) return;

    let isOpen = false;

    function openModal() {
      isOpen = true;
      overlay?.classList.add("is-open");
      document.body.style.overflow = "hidden";
    }

    function closeModal() {
      isOpen = false;
      overlay?.classList.remove("is-open");
      document.body.style.overflow = "";
    }

    function toggleModal() {
      if (isOpen) {
        closeModal();
      } else {
        openModal();
      }
    }

    toggleBtn?.addEventListener("click", toggleModal);
    closeBtn?.addEventListener("click", closeModal);

    // Close when clicking outside modal card
    overlay.addEventListener("click", (e) => {
      if (e.target === overlay) {
        closeModal();
      }
    });

    // Global keyboard shortcuts (Alt+A or Esc)
    window.addEventListener("keydown", (e: KeyboardEvent) => {
      if (e.altKey && (e.key === "a" || e.key === "A")) {
        e.preventDefault();
        toggleModal();
      } else if (e.key === "Escape" && isOpen) {
        e.preventDefault();
        closeModal();
      }
    });

    // Listen for nav links targeting #api-playground to open modal instead of scrolling
    document.querySelectorAll('a[href="#api-playground"]').forEach((link) => {
      link.addEventListener("click", (e) => {
        e.preventDefault();
        openModal();
      });
    });
  });
</script>
