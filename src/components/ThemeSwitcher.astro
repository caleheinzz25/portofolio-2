---
const themes = [
  { name: 'gold', label: 'Gold', color: '#f59e0b' },
  { name: 'emerald', label: 'Emerald', color: '#10b981' },
  { name: 'rose', label: 'Rose', color: '#f43f5e' },
  { name: 'violet', label: 'Violet', color: '#8b5cf6' },
  { name: 'cyan', label: 'Cyan', color: '#06b6d4' },
  { name: 'terminal', label: 'Terminal', color: '#22c55e' },
  { name: 'amber', label: 'Amber', color: '#fbbf24' },
  { name: 'pink', label: 'Cyber Pink', color: '#ec4899' },
];
---

<script is:inline>
  (function () {
    try {
      var saved = localStorage.getItem('portfolio-accent');
      var validThemes = ['gold', 'emerald', 'rose', 'violet', 'cyan', 'terminal', 'amber', 'pink'];
      if (saved) {
        if (validThemes.indexOf(saved) !== -1) {
          document.documentElement.setAttribute('data-theme', saved);
        } else if (/^#[0-9A-Fa-f]{6}$/.test(saved)) {
          document.documentElement.style.setProperty('--color-accent', saved);
          document.documentElement.style.setProperty('--color-mint', saved);
          document.documentElement.style.setProperty('--color-accent-hover', saved);
          document.documentElement.style.setProperty('--color-accent-glow', saved + '59');
          document.documentElement.style.setProperty('--color-accent-light', saved + '26');
        }
      } else {
        document.documentElement.setAttribute('data-theme', 'gold');
      }
    } catch (e) {
      document.documentElement.setAttribute('data-theme', 'gold');
    }
  })();
</script>

<div class="fixed bottom-5 right-5 z-50 flex flex-col items-end" id="theme-switcher-root">
  <!-- Pop-up Color Selection Palette Menu -->
  <div
    id="color-palette-menu"
    class="hidden mb-3 p-4 bg-navy/95 border border-slate/30 rounded-2xl shadow-2xl backdrop-blur-xl w-72 sm:w-80 font-mono text-light-slate transition-all duration-300 transform origin-bottom-right select-none z-50 space-y-3"
    role="dialog"
    aria-label="Color Selection Palette"
  >
    <div class="flex items-center justify-between border-b border-slate/20 pb-2">
      <div class="flex items-center gap-2">
        <span class="text-mint text-base">🎨</span>
        <span class="text-xs font-serif font-bold text-light-slate">Color Palette & Accents</span>
      </div>
      <button
        id="close-palette-btn"
        type="button"
        class="text-slate hover:text-mint p-1 text-xs cursor-pointer focus:outline-none"
        title="Close Palette"
      >
        ✕
      </button>
    </div>

    <!-- Presets Grid -->
    <div>
      <p class="text-[11px] text-slate mb-2">Preset Themes:</p>
      <div class="grid grid-cols-4 gap-2">
        {
          themes.map((theme) => (
            <button
              type="button"
              data-theme-option={theme.name}
              data-color={theme.color}
              title={`${theme.label} theme`}
              class="flex flex-col items-center gap-1.5 p-2 rounded-xl border border-slate/20 hover:border-slate/50 hover:bg-slate/10 transition-all cursor-pointer text-[10px] group focus:outline-none"
            >
              <span
                class="w-5 h-5 rounded-full border border-white/20 group-hover:scale-110 transition-transform"
                style={`background-color: ${theme.color};`}
              ></span>
              <span class="text-slate group-hover:text-light-slate truncate w-full text-center">{theme.label}</span>
            </button>
          ))
        }
      </div>
    </div>

    <!-- Custom Color Picker -->
    <div class="pt-2 border-t border-slate/20">
      <p class="text-[11px] text-slate mb-2">Custom Hex Color:</p>
      <div class="flex items-center gap-2 bg-light-navy/50 p-2 rounded-xl border border-slate/20">
        <input
          type="color"
          id="custom-color-input"
          class="w-7 h-7 rounded border-none bg-transparent cursor-pointer"
          value="#f59e0b"
          title="Pick custom color"
        />
        <input
          type="text"
          id="custom-hex-input"
          class="flex-1 bg-transparent border-none outline-none font-mono text-xs text-mint uppercase p-0 m-0"
          placeholder="#HEXCOLOR"
          maxlength="7"
        />
        <button
          id="apply-custom-color-btn"
          type="button"
          class="px-2.5 py-1 text-[11px] font-bold bg-mint/20 hover:bg-mint/30 text-mint border border-mint/30 rounded-lg transition-colors cursor-pointer"
        >
          Apply
        </button>
      </div>
    </div>
  </div>

  <!-- Main Feature Toggle Button on Color Icon -->
  <button
    id="toggle-palette-btn"
    type="button"
    class="flex items-center gap-2.5 px-3.5 py-2 bg-navy/90 border border-slate/30 hover:border-mint/60 rounded-full shadow-2xl backdrop-blur-md transition-all duration-300 hover:scale-105 cursor-pointer text-xs font-mono group focus:outline-none"
    aria-label="Toggle Color Palette"
    title="Open Color Palette"
  >
    <div class="w-6 h-6 rounded-full flex items-center justify-center text-mint bg-mint/10 border border-mint/30 group-hover:bg-mint/20">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.92 0 1.7-.63 1.9-1.5.17-.76-.23-1.5-.9-1.9-.38-.23-.6-.65-.6-1.1 0-.83.67-1.5 1.5-1.5H16c3.3 0 6-2.7 6-6 0-5.5-4.5-10-10-10z"></path>
        <circle cx="13.5" cy="6.5" r=".5" fill="currentColor"></circle>
        <circle cx="17.5" cy="10.5" r=".5" fill="currentColor"></circle>
        <circle cx="8.5" cy="7.5" r=".5" fill="currentColor"></circle>
        <circle cx="6.5" cy="12.5" r=".5" fill="currentColor"></circle>
      </svg>
    </div>
    <span class="text-light-slate font-semibold hidden sm:inline">Theme</span>
    <span id="active-color-dot" class="w-3 h-3 rounded-full border border-white/30 transition-all duration-300" style="background-color: var(--color-accent, #f59e0b);"></span>
  </button>
</div>

<script>
  function setupThemeSwitcher() {
    const root = document.getElementById("theme-switcher-root");
    const toggleBtn = document.getElementById("toggle-palette-btn");
    const closeBtn = document.getElementById("close-palette-btn");
    const menu = document.getElementById("color-palette-menu");
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-theme-option]');
    const colorInput = document.getElementById("custom-color-input") as HTMLInputElement | null;
    const hexInput = document.getElementById("custom-hex-input") as HTMLInputElement | null;
    const applyBtn = document.getElementById("apply-custom-color-btn");
    const activeDot = document.getElementById("active-color-dot");

    const validThemes = ['gold', 'emerald', 'rose', 'violet', 'cyan', 'terminal', 'amber', 'pink'];

    function toggleMenu(show?: boolean) {
      if (!menu) return;
      const isHidden = menu.classList.contains("hidden");
      const shouldShow = show !== undefined ? show : isHidden;
      if (shouldShow) {
        menu.classList.remove("hidden");
      } else {
        menu.classList.add("hidden");
      }
    }

    function applyPreset(themeName: string) {
      document.documentElement.style.cssText = "";
      document.documentElement.setAttribute("data-theme", themeName);
      try {
        localStorage.setItem("portfolio-accent", themeName);
      } catch (e) {}
      updateActiveUI();
    }

    function applyCustomHex(hex: string) {
      if (!/^#[0-9A-Fa-f]{6}$/.test(hex)) return;
      document.documentElement.removeAttribute("data-theme");
      document.documentElement.style.setProperty("--color-accent", hex);
      document.documentElement.style.setProperty("--color-mint", hex);
      document.documentElement.style.setProperty("--color-accent-hover", hex);
      document.documentElement.style.setProperty("--color-accent-glow", hex + "59");
      document.documentElement.style.setProperty("--color-accent-light", hex + "26");
      try {
        localStorage.setItem("portfolio-accent", hex);
      } catch (e) {}
      updateActiveUI();
    }

    function updateActiveUI() {
      const currentTheme = document.documentElement.getAttribute("data-theme");
      const computedColor = getComputedStyle(document.documentElement).getPropertyValue("--color-accent").trim();

      if (activeDot) activeDot.style.backgroundColor = computedColor;
      if (colorInput) colorInput.value = computedColor.startsWith("#") ? computedColor : "#f59e0b";
      if (hexInput) hexInput.value = computedColor;

      buttons.forEach((btn) => {
        const theme = btn.getAttribute("data-theme-option");
        if (currentTheme && theme === currentTheme) {
          btn.classList.add("ring-2", "ring-mint", "border-mint");
        } else {
          btn.classList.remove("ring-2", "ring-mint", "border-mint");
        }
      });
    }

    toggleBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      toggleMenu();
    });

    closeBtn?.addEventListener("click", () => {
      toggleMenu(false);
    });

    document.addEventListener("click", (e) => {
      if (root && !root.contains(e.target as Node)) {
        toggleMenu(false);
      }
    });

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const theme = btn.getAttribute("data-theme-option");
        if (theme && validThemes.includes(theme)) {
          applyPreset(theme);
        }
      });
    });

    colorInput?.addEventListener("input", (e) => {
      const val = (e.target as HTMLInputElement).value;
      if (hexInput) hexInput.value = val;
    });

    applyBtn?.addEventListener("click", () => {
      if (hexInput?.value) {
        let val = hexInput.value.trim();
        if (!val.startsWith("#")) val = "#" + val;
        applyCustomHex(val);
      }
    });

    updateActiveUI();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupThemeSwitcher);
  } else {
    setupThemeSwitcher();
  }
  document.addEventListener('astro:page-load', setupThemeSwitcher);
</script>
